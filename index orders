        function openNewProductForm() {
            document.getElementById('editModalTitle').textContent = 'Add New Kawaii Product';
            document.getElementById('editProdId').value = '';
            document.getElementById('editProdName').value = '';
            document.getElementById('editProdImg').value = '';
            document.getElementById('editProdEmoji').value = '🎀';
            document.getElementById('editProdCategory').value = 'Hello Kitty';
            document.getElementById('editProdPrice').value = '19.99';
            document.getElementById('editProdDesc').value = 'Official Sanrio merchandise item.';
            document.getElementById('editProductModal').classList.remove('hidden');
        }

        function openEditProductForm(productId) {
            const p = products.find(item => item.id === productId);
            if (!p) return;

            document.getElementById('editModalTitle').textContent = 'Edit Product & Image';
            document.getElementById('editProdId').value = p.id;
            document.getElementById('editProdName').value = p.name;
            document.getElementById('editProdImg').value = p.img || '';
            document.getElementById('editProdEmoji').value = p.emoji;
            document.getElementById('editProdCategory').value = p.category;
            document.getElementById('editProdPrice').value = p.price;
            document.getElementById('editProdDesc').value = p.desc;
            document.getElementById('editProductModal').classList.remove('hidden');
        }

        function closeEditProductModal() {
            document.getElementById('editProductModal').classList.add('hidden');
        }

        function saveProductChanges(e) {
            e.preventDefault();
            const id = document.getElementById('editProdId').value;
            const name = document.getElementById('editProdName').value;
            const img = document.getElementById('editProdImg').value;
            const emoji = document.getElementById('editProdEmoji').value;
            const category = document.getElementById('editProdCategory').value;
            const price = parseFloat(document.getElementById('editProdPrice').value);
            const desc = document.getElementById('editProdDesc').value;

            if (id) {
                // Edit existing
                const p = products.find(item => item.id == id);
                if (p) {
                    p.name = name;
                    p.img = img;
                    p.emoji = emoji;
                    p.category = category;
                    p.price = price;
                    p.desc = desc;
                }
                showToast('Product Updated! ✨', `${name} has been successfully updated.`);
            } else {
                // Create new
                const newId = products.length > 0 ? Math.max(...products.map(p => p.id)) + 1 : 1;
                products.unshift({
                    id: newId,
                    name,
                    img,
                    emoji,
                    category,
                    type: 'Plushies',
                    price,
                    rating: 5.0,
                    reviews: 1,
                    featured: true,
                    desc
                });
                showToast('Product Created! 🎀', `${name} added to catalog successfully.`);
            }

            closeEditProductModal();
            renderProducts();
            renderAdminProducts();
        }

        function deleteProduct(productId) {
            if (confirm('Are you sure you want to delete this product?')) {
                products = products.filter(p => p.id !== productId);
                renderProducts();
                renderAdminProducts();
                showToast('Product Deleted', 'Item removed from store catalog.', '🗑️');
            }
        }

        function clearAllOrders() {
            if (confirm('Are you sure you want to clear all customer orders history?')) {
                orders = [];
                updateOrderBadge();
                renderAdminOrders();
            }
        }


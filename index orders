        function switchAdminTab(tab) {
            const btnOrders = document.getElementById('adminTabOrders');
            const btnProducts = document.getElementById('adminTabProducts');
            const panelOrders = document.getElementById('adminPanelOrders');
            const panelProducts = document.getElementById('adminPanelProducts');

            if (tab === 'orders') {
                btnOrders.className = "pb-3 text-sm font-display font-bold text-purple-600 border-b-2 border-purple-600 transition-all";
                btnProducts.className = "pb-3 text-sm font-display font-semibold text-gray-500 hover:text-gray-800 transition-all";
                panelOrders.classList.remove('hidden');
                panelProducts.classList.add('hidden');
                renderAdminOrders();
            } else {
                btnProducts.className = "pb-3 text-sm font-display font-bold text-purple-600 border-b-2 border-purple-600 transition-all";
                btnOrders.className = "pb-3 text-sm font-display font-semibold text-gray-500 hover:text-gray-800 transition-all";
                panelProducts.classList.remove('hidden');
                panelOrders.classList.add('hidden');
                renderAdminProducts();
            }
        }


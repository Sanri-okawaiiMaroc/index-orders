        // Initialize App on Load
        window.addEventListener('DOMContentLoaded', () => {
            renderProducts();
            updateCartBadge();
            updateWishlistBadge();
            updateOrderBadge();
        });

        // Filter Products by Category or Character
        function filterCategory(category) {
            currentFilter = category;
            
            // Update active pill styling
            document.querySelectorAll('.filter-pill').forEach(pill => {
                pill.classList.remove('bg-pink-400', 'text-white', 'shadow-sm');
                pill.classList.add('bg-white', 'text-gray-700', 'border', 'border-pink-200');
            });
            const activePill = document.getElementById(`pill-${category}`);
            if (activePill) {
                activePill.classList.remove('bg-white', 'text-gray-700', 'border', 'border-pink-200');
                activePill.classList.add('bg-pink-400', 'text-white', 'shadow-sm');
            }

            // Update header title
            document.getElementById('categoryTitle').textContent = category === 'All' ? 'All Sanrio Products' : `${category} Collection`;
            renderProducts();
        }

        // Handle Search Input
        function handleSearch(e) {
            currentSearchQuery = e.target.value.toLowerCase().trim();
            renderProducts();
        }

        // Handle Sorting
        function handleSort(e) {
            currentSort = e.target.value;
            renderProducts();
        }

        // Render Products to Grid
        function renderProducts() {
            let filtered = products.filter(product => {
                const matchesCategory = currentFilter === 'All' || 
                                      product.category === currentFilter || 
                                      product.type === currentFilter;
                const matchesSearch = product.name.toLowerCase().includes(currentSearchQuery) ||
                                      product.desc.toLowerCase().includes(currentSearchQuery) ||
                                      product.category.toLowerCase().includes(currentSearchQuery);
                return matchesCategory && matchesSearch;
            });

            // Sorting logic
            if (currentSort === 'price-low') {
                filtered.sort((a, b) => a.price - b.price);
            } else if (currentSort === 'price-high') {
                filtered.sort((a, b) => b.price - a.price);
            } else if (currentSort === 'rating') {
                filtered.sort((a, b) => b.rating - a.rating);
            }

            const grid = document.getElementById('productGrid');
            const emptyState = document.getElementById('emptyState');
            const countText = document.getElementById('productCountText');

            countText.textContent = `Showing ${filtered.length} kawaii items`;

            if (filtered.length === 0) {
                grid.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');
            grid.innerHTML = filtered.map(product => {
                const imageHTML = product.img && product.img.trim() !== '' 
                    ? `<img src="${product.img}" alt="${product.name}" class="w-full h-full object-cover rounded-2xl" onerror="this.onerror=null; this.parentElement.innerHTML='<span class=\\'text-7xl\\'>${product.emoji}</span>';">`
                    : `<span class="text-7xl">${product.emoji}</span>`;

                return `
                    <div class="bg-white rounded-3xl p-5 border border-pink-100 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group relative">
                        <!-- Wishlist Heart Button -->
                        <button onclick="event.stopPropagation(); toggleWishlist(${product.id})" class="absolute top-4 right-4 z-10 w-9 h-9 bg-white/80 hover:bg-white rounded-full flex items-center justify-center text-pink-400 shadow-xs transition-transform active:scale-90">
                            <i class="fa-${wishlist.includes(product.id) ? 'solid' : 'regular'} fa-heart"></i>
                        </button>

                        <!-- Card Image Container -->
                        <div onclick="openProductModal(${product.id})" class="w-full h-48 bg-gradient-to-br from-pink-50 to-purple-50 rounded-2xl flex items-center justify-center cursor-pointer group-hover:scale-105 transition-transform duration-300 mb-4 select-none overflow-hidden">
                            ${imageHTML}
                        </div>

                        <!-- Details -->
                        <div onclick="openProductModal(${product.id})" class="cursor-pointer flex-grow">

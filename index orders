        // Render Admin Products List for editing
        function renderAdminProducts() {
            const container = document.getElementById('adminProductList');
            container.innerHTML = products.map(p => `
                <div class="flex items-center justify-between bg-white p-3 rounded-xl border border-purple-100 text-sm">
                    <div class="flex items-center space-x-3">
                        <div class="w-12 h-12 bg-pink-50 rounded-lg flex items-center justify-center text-xl overflow-hidden shrink-0">
                            ${p.img ? `<img src="${p.img}" class="w-full h-full object-cover">` : p.emoji}
                        </div>
                        <div>
                            <h5 class="font-semibold text-gray-800 line-clamp-1">${p.name}</h5>
                            <span class="text-xs text-pink-500 font-bold">$${p.price.toFixed(2)} • <span class="text-gray-400">${p.category}</span></span>
                        </div>
                    </div>
                    <div class="flex space-x-2">
                        <button onclick="openEditProductForm(${p.id})" class="px-3 py-1.5 bg-purple-50 hover:bg-purple-100 text-purple-700 text-xs font-semibold rounded-lg transition-colors">
                            <i class="fa-solid fa-pen mr-1"></i> Edit
